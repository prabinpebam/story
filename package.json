{
  "name": "story",
  "version": "0.1.0",
  "type": "module",
  "description": "Modern presentation creation tool",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "perf:bench": "node scripts/perf/perf-bench.mjs",
    "perf:bench:gate": "node scripts/perf/perf-bench.mjs --gate",
    "perf:soak": "node scripts/perf/perf-soak.mjs",
    "perf:coverage": "node scripts/perf/perf-coverage-lint.mjs",
    "spec:index": "node scripts/generate-product-spec-index.mjs",
    "spec:index:check": "node scripts/generate-product-spec-index.mjs --check",
    "spec:r1": "node scripts/generate-r1-profile-ledger.mjs",
    "spec:r1:check": "node scripts/generate-r1-profile-ledger.mjs --check",
    "spec:protocols": "node scripts/generate-protocol-registry.mjs",
    "spec:protocols:check": "node scripts/generate-protocol-registry.mjs --check",
    "spec:validate": "node scripts/generate-product-spec-index.mjs --check && node scripts/generate-r1-profile-ledger.mjs --check && node scripts/generate-protocol-registry.mjs --check && node scripts/validate-product-spec.mjs && node scripts/validate-product-spec-hardening.mjs",
    "implementation:ledger": "node scripts/generate-implementation-ledger.mjs",
    "implementation:ledger:check": "node scripts/generate-implementation-ledger.mjs --check",
    "implementation:validate": "npm run spec:validate && node scripts/generate-implementation-ledger.mjs --check",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.57.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.55.0",
    "jsdom": "^23.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "animejs": "^3.2.2",
    "jszip": "^3.10.1",
    "martinez-polygon-clipping": "^0.7.4"
  }
}
